{
  "manifest_version": 3,
  "name": "Paranoia Mode",
  "version": "1.0",
  "description": "See how much websites are spying on you — horror edition!",
  "permissions": ["tabs", "webRequest", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "assets/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
